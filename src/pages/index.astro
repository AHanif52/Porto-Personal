              ))}
            </ul>
          </div>
        </section>

        <!-- Path: intermediate events on a line -->
        <section id="path" class="wrap block" aria-labelledby="path-h">
          <h2 id="path-h" class="node-h">Path so far</h2>
          <ol class="events">
            {timeline.map((t, i) => (
              <li class={i === 0 ? 'now' : ''}>
                <p class="when">{t.when}</p>
                <h3>{t.what}</h3>
                <p class="where">{t.where}</p>
                {t.note && <p class="note">{t.note}</p>}
              </li>
            ))}
