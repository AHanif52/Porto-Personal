---
import { site } from '../data/content';
---

<section id="contact" class="contact" aria-labelledby="contact-h">
  <div class="wrap" data-reveal>
    <h2 id="contact-h">Hiring an analyst?</h2>
    <p class="lead">Open to Business, System and Project Analyst roles. Email is the fastest way to reach me.</p>
    <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    <p class="else">
      <a class="link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr"> (new tab)</span></a>
      <a class="link" href={site.github} target="_blank" rel="noopener">GitHub<span class="sr"> (new tab)</span></a>
      <a class="link" href={site.cv} target="_blank" rel="noopener">Download CV<span class="sr"> (PDF, new tab)</span></a>
    </p>
    <p class="foot">Mohammad Aufa Hanif, Tegal, Indonesia</p>
  </div>
</section>

<style>
  /* The page ends on a tinted plane with a leaning top edge, echoing the hero */
  .contact { margin-top: 40px; padding-block: 220px 56px; background: var(--surface); clip-path: polygon(0 110px, 100% 0, 100% 100%, 0 100%); scroll-margin-top: 0; }
  .mail {
    display: inline-block; margin-top: 48px; font-size: clamp(1.5rem, 5.6vw, 5.2rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.1;
    text-decoration: none; overflow-wrap: anywhere;
    background: linear-gradient(var(--acc), var(--acc)) 0 100% / 100% 0.09em no-repeat; padding-bottom: 0.08em;
    transition: background-size 0.3s var(--ease), color 0.3s;
  }
  .mail:hover { background-size: 100% 100%; color: #161614; }
  .else { display: flex; flex-wrap: wrap; gap: 16px 36px; margin-top: 48px; }
  .foot { margin-top: 120px; color: var(--mute); font-size: 0.95rem; }

  @media (max-width: 720px) {
    .contact { padding-block: 130px 40px; clip-path: polygon(0 56px, 100% 0, 100% 100%, 0 100%); }
    .foot { margin-top: 72px; }
  }
</style>
