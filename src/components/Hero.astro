---
import { Image } from 'astro:assets';
import profile from '../assets/profile.png';
import { site, hero } from '../data/content';
---

<section class="hero" id="top">
  <div class="wrap">
    <p class="role slant">{hero.role}</p>
    <h1>
      <span class="line">Client requests in.</span>
      <span class="line">
        <Image src={profile} alt="Portrait of Aufa Hanif" width={120} height={120} densities={[1, 2]} loading="eager" />Buildable specs <em>out.</em>
      </span>
    </h1>
    <div class="under">
      <p class="sub">{hero.sub}</p>
      <div class="cta">
        <a class="btn" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn btn-ghost" href={site.cv} target="_blank" rel="noopener">Download CV<span class="sr"> (PDF, new tab)</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  /* The hero is exactly the first screen: nothing from the next section peeks in half-finished */
  .hero { min-height: calc(100dvh - 72px); display: grid; align-items: center; padding-block: 24px 88px; }
  /* The role is the first thing read, before the headline */
  .role { font-size: clamp(1.4rem, 2.2vw, 2rem); letter-spacing: 0.02em; color: var(--acc); margin-bottom: 14px;  }
  h1 { font-size: clamp(2.5rem, 8.1vw, 8rem); line-height: 0.98; font-weight: 600; letter-spacing: -0.055em; }
  .line { display: block; }
  h1 :global(img) {
    display: inline-block; width: 0.78em; height: 0.78em; border-radius: 50%; vertical-align: -0.07em; margin-right: 0.08em;
  }
  em { font-style: normal; color: var(--acc); }
  /* Load-in: role, the two headline lines, then the rest, so the eye lands in reading order */
  @media (prefers-reduced-motion: no-preference) {
    .role, .line, .under { animation: rise 0.9s var(--ease) both; }
    .line:nth-child(1) { animation-delay: 0.08s; }
    .line:nth-child(2) { animation-delay: 0.2s; }
    .under { animation-delay: 0.36s; }
    h1 :global(img) { animation: pop 0.8s var(--ease) 0.5s both; }
    @keyframes rise { from { opacity: 0; transform: translateY(0.3em); } }
    @keyframes pop { from { transform: scale(0) rotate(-40deg); } }
  }

  .under { margin-top: 44px; }
  .sub { font-size: 1.375rem; color: var(--mute); max-width: 48ch; }
  .cta { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 36px; padding-inline: 6px; }

  @media (max-width: 720px) {
    .hero { min-height: 0; padding-block: 28px 72px; }
    .under { margin-top: 32px; }
    .sub { font-size: 1.125rem; }
  }
</style>
