---
import { projects, earlier } from '../data/content';
---

<section class="wrap sec" aria-labelledby="more-h">
  <h2 id="more-h">More work</h2>
  <ul class="projects">
    {projects.map((p) => (
      <li data-reveal>
        <div>
          <p class="meta">{p.meta}</p>
          <h3>{p.title}</h3>
          <p class="role slant">{p.role}</p>
        </div>
        <div>
          <p class="sum">{p.summary}</p>
          <ul class="ticks">
            {p.did.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ul>

  <h3 class="sub slant">Earlier</h3>
  <ul class="rows">
    {earlier.map((e) => (
      <li>
        <h4>{e.title}</h4>
        <p>{e.text}</p>
        <span>{e.year}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .projects { margin-top: 64px; border-top: 2px solid var(--ink); }
  .projects > li { display: grid; grid-template-columns: 5fr 7fr; gap: 24px 72px; padding-block: 44px; border-bottom: 1px solid var(--line); }
  .meta { margin-bottom: 10px; }
  .projects h3 { font-size: clamp(1.6rem, 2.4vw, 2.1rem); letter-spacing: -0.035em; max-width: 18ch; text-wrap: balance; }
  .role { margin-top: 12px; font-size: 1.2rem; letter-spacing: 0.02em; }
  .sum { font-size: 1.2rem; max-width: 52ch; }
  .ticks { margin-top: 18px; display: grid; gap: 8px; color: var(--mute); }
  /* Leaning tick instead of a bullet */
  .ticks li { position: relative; padding-left: 26px; }
  .ticks li::before { content: ''; position: absolute; left: 2px; top: 0.62em; width: 12px; height: 6px; background: var(--acc); transform: skewX(-32deg); }

  .sub { margin-top: 80px; font-size: 1.6rem; letter-spacing: 0.02em; }
  .rows { margin-top: 12px; }
  .rows li { display: grid; grid-template-columns: 5fr 7fr 90px; gap: 8px 72px; align-items: baseline; padding-block: 16px; }
  h4 { margin: 0; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.02em; }
  .rows p, .rows span { color: var(--mute); font-size: 1.05rem; }
  .rows span { font-variant-numeric: tabular-nums; text-align: right; }

  @media (max-width: 860px) {
    .projects { margin-top: 44px; }
    .projects > li { grid-template-columns: 1fr; padding-block: 32px; }
    .sub { margin-top: 56px; }
    .rows li { grid-template-columns: 1fr auto; gap: 4px 24px; }
    .rows p { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
