---
import { cv } from '../data/content';
---

<header class="wrap top">
  <a class="brand" href="#"><span class="ev ev-sm" aria-hidden="true"></span>Aufa Hanif</a>
  <nav aria-label="Main">
    <a href="#work">Work</a>
    <a href="#path">Path</a>
    <a href="#contact">Contact</a>
    <a class="nav-cv" href={cv} target="_blank" rel="noopener">Download CV<span class="sr"> (PDF, new tab)</span></a>
  </nav>
</header>

<style is:global>
  /* Sticky so the CV button is never more than a glance away */
  .top {
    display: flex; justify-content: space-between; align-items: center; min-height: 72px; gap: 16px;
    position: sticky; top: 0; z-index: 5; background: var(--bp); box-shadow: 0 0 0 100vmax var(--bp); clip-path: inset(0 -100vmax);
  }
  section[id] { scroll-margin-top: 88px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .top nav { display: flex; align-items: center; gap: 24px; }
  .top nav a { text-decoration: none; font-weight: 500; }
  .nav-cv { padding: 6px 12px; border: 1.5px solid var(--line); border-radius: var(--radius); white-space: nowrap; }
  .nav-cv:hover { border-color: var(--accent); }

  @media (max-width: 640px) {
    .top nav { gap: 14px; }
    .top nav a[href='#path'], .top nav a[href='#work'] { display: none; }
  }
</style>
