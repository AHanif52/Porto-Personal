---
// Content lives in src/data/content.ts. Each section is a component in src/components.
// The page is drawn as a BPMN diagram: start event (hero), lanes, events, end event (contact).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Path from '../components/Path.astro';
import Toolkit from '../components/Toolkit.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <div class="spine">
      <Work />
      <Path />
      <Toolkit />
    </div>
    <Contact />
  </main>
  <footer class="wrap foot">
    <p>Mohammad Aufa Hanif, Tegal, Indonesia</p>
  </footer>
</Base>
