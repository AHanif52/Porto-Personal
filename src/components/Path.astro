---
import { timeline } from '../data/content';
---

<!-- Path: intermediate events on a line -->
<section id="path" class="wrap block" aria-labelledby="path-h">
  <h2 id="path-h" class="node-h">Path so far</h2>
  <ol class="events">
    {timeline.map((t, i) => (
      <li class={i === 0 ? 'now' : ''}>
        <p class="when">{t.when}</p>
        <h3>{t.what}</h3>
        <p class="where">{t.where}</p>
        {t.note && <p class="note">{t.note}</p>}
      </li>
    ))}
  </ol>
</section>

<style is:global>
  /* Path: intermediate events (double ring), one column so it reads top to bottom */
  .events { display: grid; gap: 28px; max-width: 640px; }
  .events li { position: relative; padding-left: 32px; }
  .events li::before {
    content: ''; position: absolute; left: 0; top: 3px; width: 18px; height: 18px; border-radius: 50%;
    border: 2px solid var(--line); background: var(--bp); box-shadow: inset 0 0 0 2px var(--bp), inset 0 0 0 4px var(--line);
  }
  .events li.now::before { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 3px var(--bp); }
  .when { font-size: 0.875rem; color: var(--muted); }
  .events h3 { font-size: 1.125rem; font-weight: 700; color: #fff; }
  .where { font-weight: 500; }
  .note { color: var(--muted); font-size: 0.95rem; max-width: 48ch; }
</style>
