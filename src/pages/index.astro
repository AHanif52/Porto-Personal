---
// Content lives in src/data/content.ts. Each section is one component in src/components.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Featured from '../components/Featured.astro';
import Work from '../components/Work.astro';
import Gemi from '../components/Gemi.astro';
import Experience from '../components/Experience.astro';
import Toolkit from '../components/Toolkit.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Featured />
    <Work />
    <Gemi />
    <Experience />
    <Toolkit />
    <Contact />
  </main>
</Base>
