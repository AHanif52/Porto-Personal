---
import { Image } from 'astro:assets';
import profile from '../assets/profile.png';
import gemiBeranda from '../assets/gemi-beranda.png';
import gemiLaporan from '../assets/gemi-laporan.png';
import gemiKantong from '../assets/gemi-kantong.png';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/kalam/400.css';

// Edit content here. Everything on the page renders from these lists.
// The page is drawn as a BPMN diagram: start event (hero), lanes, events, end event (contact).
// Client names are anonymised on purpose: this page is public, the CV (sent privately) carries real names.

const featured = {
  client: 'National ISP',
  year: '2026 - now',
  title: 'As-built approval workflow for fiber rollout',
  summary:
    'Vendors submit route maps, as-built documents and acceptance photos. Reviewers, approvers and construction managers sign off in turn before the network is handed to maintenance. Three network segments, one workflow.',
  figures: [
    { n: '~165', label: 'user stories written' },
    { n: '128', label: 'test cases mapped to dev tasks' },
    { n: '204', label: 'APIs catalogued' },
    { n: 'Aug 2026', label: 'released to production' },
  ],
  did: [
    'Wrote the requirements spec, ERD and BPMN; the BPMN passed validation and was deployed',
    'Built a clickable mockup for 3 monitoring dashboards, reusing the existing dashboard pattern',
    'Automated 32 dashboard tests in Playwright',
  ],
};

const lanes = [
  {
    client: 'Finance co-op, Malaysia',
    year: '2026',
    title: 'Finance reporting portal',
    summary: 'A reporting portal on top of a data warehouse, used by the finance team for daily and monthly reports.',
    flow: ['Finance needs', '37 report layouts', 'Warehouse queries', 'Dashboards', 'UAT'],
    end: 'Client sign-off',
    did: ['SSRS reports for receipts, payments, vouchers, claims, profit and loss, cash book', 'Report filters and Excel export'],
  },
];

const earlier = [
  { client: 'National ISP', year: '2024 - 2025', title: 'FTTH rollout workflow system', text: 'BPMN validated in Camunda, ERD, mockups, API and UI testing.' },
  { client: 'Advertising agency', year: '2025', title: 'Advertising asset CMS', text: 'Asset flow from upload to distribution for every client.' },
  { client: 'Internal tool', year: '2025', title: 'WhatsApp blasting app', text: 'Bulk messaging through a third-party gateway.' },
];

const gemi = {
  title: 'Gemi, an offline money app',
  summary:
    'A personal finance app for Android with no account and no server. I ran it like a client project: BRD first, a 21-screen prototype, then the Flutter build.',
  flow: ['BRD', '21-screen prototype', 'Flutter build'],
  end: 'APK v1.0.1',
  url: 'https://github.com/AHanif52/gemi',
  shots: [
    { src: gemiBeranda, alt: "Gemi home screen showing remaining September budget and today's expenses" },
    { src: gemiLaporan, alt: 'Gemi weekly report with a bar chart of daily spending' },
    { src: gemiKantong, alt: 'Gemi wallets screen listing bank, e-money and cash balances' },
  ],
};

const timeline = [
  { when: 'Jun 2026 - now', what: 'Project Analyst', where: 'PT Javan Cipta Solusi', note: 'Requirements with client users, project scope, timelines with the Tribe Lead, UAT. The Product Owner role merged into this one.' },
  { when: 'Dec 2024 - Jun 2026', what: 'System Analyst', where: 'PT Javan Cipta Solusi', note: 'Analyst and consultant on client projects.' },
  { when: 'Jul - Dec 2024', what: 'System Analyst Intern', where: 'PT Javan Cipta Solusi', note: 'Moved from programming to analysis.' },
  { when: 'Jun - Jul 2024', what: 'PHP Programmer Intern', where: 'PT Javan Cipta Solusi', note: 'APIs and pages for an internal QA tool.' },
  { when: '2023', what: 'Bangkit Academy', where: 'Google, GoTo, Traveloka', note: 'Android path, capstone with machine learning.' },
  { when: '2020 - 2024', what: 'Information Systems, GPA 3.78', where: 'Universitas Amikom Yogyakarta', note: '' },
];

const toolkit = [
  { group: 'Analysis', items: ['Requirement gathering', 'User stories', 'Acceptance criteria', 'UAT'] },
  { group: 'Modeling', items: ['BPMN', 'Camunda Modeler', 'ERD', 'draw.io'] },
  { group: 'Delivery', items: ['Scrum', 'Gantt planning', 'Scope management', 'ActiveCollab'] },
  { group: 'Testing', items: ['Postman', 'Apidog', 'Playwright', 'Sentry'] },
  { group: 'Data', items: ['SQL', 'SSRS', 'Metabase', 'PostgreSQL'] },
  { group: 'Design and code', items: ['Figma', 'Balsamiq', 'PHP', 'Laravel', 'React', 'Flutter'] },
];

const codeProjects = [
  { name: 'LigaEnggres', kind: 'Android', url: 'https://github.com/AHanif52/LigaEnggres' },
  { name: 'Village API', kind: 'REST API', url: 'https://github.com/AHanif52/memento-mori' },
  { name: 'StoryApps', kind: 'Android', url: 'https://github.com/AHanif52/Submision_intermediate' },
];

const cv = '/CV-Aufa-Hanif.pdf';

// Structured data so search engines and AI screeners read the same facts the page shows.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mohammad Aufa Hanif',
  jobTitle: 'Project Analyst',
  worksFor: { '@type': 'Organization', name: 'PT Javan Cipta Solusi' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitas Amikom Yogyakarta' },
  address: { '@type': 'PostalAddress', addressLocality: 'Tegal', addressCountry: 'ID' },
  email: 'mailto:aufahanif85@gmail.com',
  url: 'https://aufahanif.supsub.my.id',
  sameAs: ['https://www.linkedin.com/in/aufahanif/', 'https://github.com/AHanif52'],
  knowsAbout: [
    'Business Analysis', 'System Analysis', 'Requirement Gathering', 'Scope Management', 'User Acceptance Testing',
    'BPMN', 'Camunda', 'ERD', 'User Stories', 'Acceptance Criteria', 'Test Cases', 'SQL', 'SSRS', 'Metabase',
    'Scrum', 'Gantt Chart Planning', 'Figma', 'Postman', 'Playwright',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f3a63" />
    <title>Mohammad Aufa Hanif, Project Analyst (Business and System Analyst)</title>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <meta name="description" content="Mohammad Aufa Hanif, Project Analyst (Business and System Analyst) with 2+ years turning client requests into scoped, tested specs teams can build." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230f3a63'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%23FFD84A' stroke-width='3'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="wrap top">
      <a class="brand" href="#"><span class="ev ev-sm" aria-hidden="true"></span>Aufa Hanif</a>
      <nav aria-label="Main">
        <a href="#work">Work</a>
        <a href="#path">Path</a>
        <a href="#contact">Contact</a>
        <a class="nav-cv" href={cv} target="_blank" rel="noopener">Download CV<span class="sr"> (PDF, new tab)</span></a>
      </nav>
    </header>

    <main id="main">
      <!-- Start event -->
      <section class="wrap hero">
        <div class="intro">
          <div class="who">
            <h1>Mohammad Aufa Hanif</h1>
            <p class="role">Project Analyst <span>Business and System Analysis, 2+ years</span></p>
          </div>
          <div class="pitch">
            <Image src={profile} alt="Portrait of Aufa Hanif" width={168} height={168} densities={[1, 2]} class="avatar" loading="eager" />
            <p class="proof">I take a client request from first meeting to signed-off release. Latest: a fiber-rollout workflow live in production, built from ~165 user stories and 128 test cases.</p>
            <div class="actions">
              <a class="btn btn-solid" href="#contact">Contact</a>
              <a class="btn" href={cv} target="_blank" rel="noopener">Download CV<span class="sr"> (PDF, new tab)</span></a>
            </div>
          </div>
        </div>

        <figure class="diagram">
          <!-- Wide swimlane for tablets and desktop -->
          <div class="dg-wide diagram-scroll" tabindex="0" role="region" aria-label="Diagram: how a client request moves through my lane">
            <svg viewBox="0 0 1160 330" role="img" aria-labelledby="dg-t dg-d">
              <title id="dg-t">How a client request moves through my lane</title>
              <desc id="dg-d">BPMN diagram with three lanes. The client sends a request. I gather requirements and write the user story with acceptance criteria. Developers build and QA tests it. The client runs UAT: if it fails, it goes back to the user story; if it passes, it is signed off.</desc>
              <defs>
                <marker id="arw" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                  <path d="M0 0L10 5L0 10z" class="arw" />
                </marker>
              </defs>
              <rect x="1" y="1" width="1158" height="328" rx="4" class="pool-r" />
              <rect x="41" y="110" width="1117" height="110" class="lane-me" />
              <path d="M1 110H1159M1 220H1159M41 1V329" class="sep" />
              <text transform="translate(26 55) rotate(-90)" class="lane-t">Client</text>
              <text transform="translate(26 165) rotate(-90)" class="lane-t me">Me</text>
              <text transform="translate(26 275) rotate(-90)" class="lane-t">Dev, QA</text>

              <g class="n" style="--d:0">
                <circle cx="100" cy="55" r="16" class="ev-s" />
                <text x="100" y="28" class="cap">Request</text>
              </g>
              <path d="M140 52H118" class="assoc n" style="--d:0.2" />
              <g class="n" style="--d:0.2" lang="id">
                <rect x="142" y="16" width="232" height="78" class="stk" transform="rotate(-2 258 55)" />
                <text x="156" y="44" class="hand" transform="rotate(-2 258 55)">&ldquo;Tiap pengajuan harus</text>
                <text x="156" y="66" class="hand" transform="rotate(-2 258 55)">di-approve dulu.&rdquo;</text>
                <text x="156" y="85" class="hand sm" transform="rotate(-2 258 55)">Client, kickoff</text>
              </g>

              <path d="M100 71V165H148" class="flow" marker-end="url(#arw)" style="--d:0.3" />
              <g class="n" style="--d:0.6">
                <rect x="150" y="130" width="130" height="70" rx="10" class="task-r" />
                <text x="215" y="161" class="lbl">Gather</text>
                <text x="215" y="181" class="lbl sm">+ scope</text>
              </g>
              <path d="M280 165H318" class="flow" marker-end="url(#arw)" style="--d:0.8" />
              <g class="n" style="--d:1">
                <rect x="320" y="130" width="150" height="70" rx="10" class="task-r me" />
                <text x="395" y="161" class="lbl">User story</text>
                <text x="395" y="181" class="lbl sm">+ acceptance criteria</text>
              </g>

              <path d="M470 165H575V238" class="flow" marker-end="url(#arw)" style="--d:1.2" />
              <g class="n" style="--d:1.4">
                <rect x="510" y="240" width="130" height="70" rx="10" class="task-r" />
                <text x="575" y="280" class="lbl">Build</text>
              </g>
              <path d="M640 275H678" class="flow" marker-end="url(#arw)" style="--d:1.6" />
              <g class="n" style="--d:1.8">
                <rect x="680" y="240" width="130" height="70" rx="10" class="task-r" />
                <text x="745" y="280" class="lbl">QC test</text>
              </g>

              <path d="M810 275H915V92" class="flow" marker-end="url(#arw)" style="--d:2" />
              <g class="n" style="--d:2.2">
                <rect x="850" y="20" width="130" height="70" rx="10" class="task-r" />
                <text x="915" y="60" class="lbl">UAT</text>
              </g>
              <path d="M980 55H1002" class="flow" marker-end="url(#arw)" style="--d:2.4" />
              <g class="n" style="--d:2.5">
                <path d="M1030 27L1058 55L1030 83L1002 55Z" class="gw" />
                <path d="M1021 46L1039 64M1039 46L1021 64" class="gw-x" />
              </g>
              <path d="M1058 55H1092" class="flow" marker-end="url(#arw)" style="--d:2.7" />
              <text x="1075" y="45" class="cap" style="--d:2.7">Yes</text>
              <path d="M1030 27V8H395V128" class="flow loop" marker-end="url(#arw)" style="--d:2.7" />
              <text x="1040" y="20" class="cap left" style="--d:2.7">No</text>
              <g class="n" style="--d:3">
                <circle cx="1110" cy="55" r="16" class="ev-e" />
                <text x="1110" y="94" class="cap strong">Signed off</text>
              </g>
            </svg>
          </div>

          <!-- Same flow with vertical lanes for phones -->
          <div class="dg-tall">
            <svg viewBox="0 0 360 640" role="img" aria-labelledby="dgm-t">
              <title id="dgm-t">How a client request moves through my lane: client request, gather and scope, user story, build, QC test, client UAT, then signed off or back to the user story.</title>
              <defs>
                <marker id="arw-m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                  <path d="M0 0L10 5L0 10z" class="arw" />
                </marker>
              </defs>
              <rect x="1" y="1" width="358" height="638" rx="4" class="pool-r" />
              <rect x="120" y="33" width="120" height="605" class="lane-me" />
              <path d="M1 32H359M120 1V639M240 1V639" class="sep" />
              <text x="60" y="22" class="lane-t">Client</text>
              <text x="180" y="22" class="lane-t me">Me</text>
              <text x="300" y="22" class="lane-t">Dev, QA</text>

              <g class="n" style="--d:0">
                <circle cx="60" cy="70" r="14" class="ev-s" />
                <text x="60" y="102" class="cap">Request</text>
              </g>
              <path d="M74 70H180V106" class="flow" marker-end="url(#arw-m)" style="--d:0.2" />
              <g class="n" style="--d:0.4">
                <rect x="130" y="108" width="100" height="52" rx="8" class="task-r" />
                <text x="180" y="131" class="lbl">Gather</text>
                <text x="180" y="149" class="lbl sm">+ scope</text>
              </g>
              <path d="M180 160V188" class="flow" marker-end="url(#arw-m)" style="--d:0.6" />
              <g class="n" style="--d:0.8">
                <rect x="126" y="190" width="108" height="56" rx="8" class="task-r me" />
                <text x="180" y="214" class="lbl">User story</text>
                <text x="180" y="233" class="lbl sm">+ criteria</text>
              </g>
              <path d="M234 218H300V268" class="flow" marker-end="url(#arw-m)" style="--d:1" />
              <g class="n" style="--d:1.2">
                <rect x="250" y="270" width="100" height="48" rx="8" class="task-r" />
                <text x="300" y="299" class="lbl">Build</text>
              </g>
              <path d="M300 318V350" class="flow" marker-end="url(#arw-m)" style="--d:1.4" />
              <g class="n" style="--d:1.6">
                <rect x="250" y="352" width="100" height="48" rx="8" class="task-r" />
                <text x="300" y="381" class="lbl">QC test</text>
              </g>
              <path d="M250 376H60V428" class="flow" marker-end="url(#arw-m)" style="--d:1.8" />
              <g class="n" style="--d:2">
                <rect x="10" y="430" width="100" height="48" rx="8" class="task-r" />
                <text x="60" y="459" class="lbl">UAT</text>
              </g>
              <path d="M60 478V500" class="flow" marker-end="url(#arw-m)" style="--d:2.2" />
              <g class="n" style="--d:2.3">
                <path d="M60 502L82 524L60 546L38 524Z" class="gw" />
                <path d="M53 517L67 531M67 517L53 531" class="gw-x" />
              </g>
              <path d="M82 524H112V218H124" class="flow loop" marker-end="url(#arw-m)" style="--d:2.5" />
              <text x="88" y="516" class="cap left" style="--d:2.5">No</text>
              <path d="M60 546V574" class="flow" marker-end="url(#arw-m)" style="--d:2.5" />
              <text x="70" y="564" class="cap left" style="--d:2.5">Yes</text>
              <g class="n" style="--d:2.7">
                <circle cx="60" cy="590" r="14" class="ev-e" />
                <text x="60" y="626" class="cap strong">Signed off</text>
              </g>
            </svg>
          </div>
          <figcaption>One request, modeled the way I work: my lane sits between the client and the build.</figcaption>
        </figure>
      </section>

      <div class="spine">
        <!-- Work: featured project with its anonymised BPMN, then the rest of the pool -->
        <section id="work" class="wrap block" aria-labelledby="work-h">
          <h2 id="work-h" class="node-h">Selected work</h2>

          <article class="feature">
            <p class="f-meta"><b>{featured.client}</b> {featured.year}</p>
            <h3>{featured.title}</h3>
            <p class="summary">{featured.summary}</p>

            <dl class="figs">
              {featured.figures.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.n}</dd>
                </div>
              ))}
            </dl>

            <div class="art-tabs" role="tablist" aria-label="Project artifacts">
              <button type="button" role="tab" id="tab-process" aria-controls="art-process" aria-selected="true">Process (BPMN)</button>
              <button type="button" role="tab" id="tab-dash" aria-controls="art-dash" aria-selected="false" tabindex="-1">Dashboard wireframe</button>
            </div>
            <figure class="artifact" id="art-process" role="tabpanel" aria-labelledby="tab-process">
              <div class="diagram-scroll art-scroll" tabindex="0" role="region" aria-label="Diagram: simplified approval workflow">
                <svg viewBox="0 0 760 256" role="img" aria-labelledby="art-t">
                  <title id="art-t">Simplified approval workflow: the vendor submits a package, a reviewer verifies it, rejected packages go back for revision, then an approver, regional and HQ construction sign off before handover to maintenance.</title>
                  <defs>
                    <marker id="arw-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                      <path d="M0 0L10 5L0 10z" class="arw" />
                    </marker>
                  </defs>
                  <rect x="1" y="1" width="758" height="254" rx="4" class="pool-r" />
                  <path d="M1 64H759M1 128H759M1 192H759M36 1V255" class="sep thin" />
                  <text transform="translate(22 32) rotate(-90)" class="lane-t xs">Vendor</text>
                  <text transform="translate(22 96) rotate(-90)" class="lane-t xs">Review</text>
                  <text transform="translate(22 160) rotate(-90)" class="lane-t xs">Build</text>
                  <text transform="translate(22 224) rotate(-90)" class="lane-t xs">Maint.</text>

                  <circle cx="60" cy="32" r="12" class="ev-s" />
                  <path d="M72 32H84" class="flow" marker-end="url(#arw-a)" />
                  <rect x="86" y="12" width="120" height="40" rx="8" class="task-r" />
                  <text x="146" y="37" class="lbl s13">Submit package</text>
                  <path d="M206 32H250V78" class="flow" marker-end="url(#arw-a)" />
                  <rect x="195" y="80" width="110" height="40" rx="8" class="task-r" />
                  <text x="250" y="105" class="lbl s13">Verify</text>
                  <path d="M305 100H338" class="flow" marker-end="url(#arw-a)" />
                  <path d="M362 78L384 100L362 122L340 100Z" class="gw" />
                  <path d="M355 93L369 107M369 93L355 107" class="gw-x" />
                  <path d="M362 78V6H146V10" class="flow loop" marker-end="url(#arw-a)" />
                  <text x="370" y="40" class="cap left">Revise</text>
                  <path d="M384 100H418" class="flow" marker-end="url(#arw-a)" />
                  <rect x="420" y="80" width="100" height="40" rx="8" class="task-r" />
                  <text x="470" y="105" class="lbl s13">Approve</text>
                  <path d="M520 100H555V142" class="flow" marker-end="url(#arw-a)" />
                  <rect x="500" y="144" width="110" height="40" rx="8" class="task-r" />
                  <text x="555" y="169" class="lbl s13">Regional sign-off</text>
                  <path d="M610 164H630" class="flow" marker-end="url(#arw-a)" />
                  <rect x="632" y="144" width="100" height="40" rx="8" class="task-r" />
                  <text x="682" y="169" class="lbl s13">HQ sign-off</text>
                  <path d="M682 184V210" class="flow" marker-end="url(#arw-a)" />
                  <circle cx="682" cy="224" r="12" class="ev-e" />
                  <text x="660" y="229" class="cap end-l">Handover</text>

                  <g transform="rotate(-2 210 200)">
                    <rect x="80" y="160" width="260" height="66" class="stk" />
                    <text x="94" y="186" class="hand">Client approved the</text>
                    <text x="94" y="210" class="hand">mockup journey, Jun 2026</text>
                  </g>
                </svg>
              </div>
              <figcaption>Simplified and anonymised. The real flow has more roles, checks and notifications.</figcaption>
            </figure>
            <figure class="artifact" id="art-dash" role="tabpanel" aria-labelledby="tab-dash">
              <div class="diagram-scroll art-scroll" tabindex="0" role="region" aria-label="Wireframe: monitoring dashboard">
                <svg viewBox="0 0 760 440" role="img" aria-labelledby="wf-t">
                  <title id="wf-t">Wireframe of the monitoring dashboard: filters on the left, six status bucket cards on the right, then a status table with export whose cells open the filtered list, and a bar chart by city. Tables and charts alternate down the page.</title>
                  <rect x="1" y="1" width="758" height="438" rx="6" class="pool-r" />
                  <path d="M1 40H759" class="sep thin" />
                  <circle cx="20" cy="20" r="5" class="wf-dot" /><circle cx="36" cy="20" r="5" class="wf-dot" /><circle cx="52" cy="20" r="5" class="wf-dot" />
                  <text x="380" y="25" class="lane-t">Dashboard: handover overview</text>

                  <rect x="16" y="56" width="304" height="152" rx="6" class="wf-box" />
                  <text x="30" y="76" class="wf-t">Filter</text>
                  <rect x="30" y="88" width="80" height="8" rx="2" class="wf-ph" /><rect x="120" y="84" width="186" height="18" rx="4" class="wf-in" /><text x="296" y="97" class="wf-t">&#9662;</text>
                  <rect x="30" y="116" width="64" height="8" rx="2" class="wf-ph" /><rect x="120" y="112" width="186" height="18" rx="4" class="wf-in" /><text x="296" y="125" class="wf-t">&#9662;</text>
                  <rect x="30" y="144" width="72" height="8" rx="2" class="wf-ph" /><rect x="120" y="140" width="186" height="18" rx="4" class="wf-in" /><text x="296" y="153" class="wf-t">&#9662;</text>
                  <rect x="166" y="172" width="62" height="24" rx="4" class="wf-in" /><text x="197" y="188" class="wf-t mid">Reset</text>
                  <rect x="236" y="172" width="70" height="24" rx="4" class="wf-btn" /><text x="271" y="188" class="wf-t mid ink">Apply</text>
                  <rect x="336" y="64" width="196" height="40" rx="6" class="wf-box" />
                  <text x="348" y="81" class="wf-t">Waiting review</text>
                  <text x="348" y="97" class="wf-n">N jobs</text>
