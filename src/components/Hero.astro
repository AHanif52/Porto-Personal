---
import { Image } from 'astro:assets';
import profile from '../assets/profile.png';
import { cv } from '../data/content';
import HeroDiagram from './diagrams/HeroDiagram.astro';
---

<!-- Start event -->
<section class="wrap hero">
  <div class="intro">
    <div class="who">
      <h1>Mohammad Aufa Hanif</h1>
      <p class="role">Project Analyst <span>Business and System Analysis, 2+ years</span></p>
    </div>
    <div class="pitch">
      <Image src={profile} alt="Portrait of Aufa Hanif" width={168} height={168} densities={[1, 2]} class="avatar" loading="eager" />
      <p class="proof">I take a client request from first meeting to signed-off release. Latest: a fiber-rollout workflow live in production, built from ~165 user stories and 128 test cases.</p>
      <p class="status"><span class="ev ev-sm" aria-hidden="true"></span>Open to Business, System and Project Analyst roles</p>
      <div class="actions">
        <a class="btn btn-solid" href="#contact">Contact</a>
        <a class="btn" href={cv} target="_blank" rel="noopener">Download CV<span class="sr"> (PDF, new tab)</span></a>
      </div>
    </div>
  </div>

  <HeroDiagram />
</section>

<style is:global>
  /* Hero */
  .hero { padding-block: 32px 112px; }
  .intro { display: grid; grid-template-columns: 1.25fr 1fr; gap: 56px; align-items: end; margin-bottom: 48px; }
  .who { display: flex; flex-direction: column; gap: 16px; }
  /* Portrait as the page's BPMN start event: thin ring, set apart from the photo */
  .avatar { width: 168px; height: 168px; border-radius: 50%; display: block; outline: 2px solid var(--line); outline-offset: 8px; margin-bottom: 32px; }
  h1 { font-size: clamp(2.6rem, 6.4vw, 5rem); line-height: 1; font-weight: 800; letter-spacing: -0.04em; max-width: 11ch; color: #fff; }
  .role { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; color: var(--accent); }
  .role span { display: block; font-size: 0.55em; font-weight: 500; letter-spacing: 0; color: var(--line); margin-top: 6px; }
  .proof { font-size: 1.15rem; max-width: 38ch; }
  .status { display: flex; align-items: center; gap: 10px; margin-top: 16px; font-weight: 600; font-size: 0.95rem; }
  .actions { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .btn {
    display: inline-block; padding: 12px 22px; border-radius: var(--radius); font-weight: 700; text-decoration: none;
    border: 1.5px solid var(--line); white-space: nowrap; transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn:hover { transform: translateY(-2px); color: var(--line); }
  .btn-solid { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .btn-solid:hover { color: var(--accent-ink); }
  .btn:active, .nav-cv:active { transform: scale(0.98); }
  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } .btn:hover { transform: none; } }

  @media (max-width: 980px) {
    .intro { grid-template-columns: 1fr; gap: 28px; }
    .intro .pitch { display: grid; grid-template-columns: auto 1fr; gap: 0 20px; align-items: start; }
    .intro .avatar { width: 72px; height: 72px; margin: 4px 0 0; outline-offset: 4px; }
    .intro .proof { font-size: 1rem; }
    .intro .actions { grid-column: 1 / -1; margin-top: 24px; }
  }

  @media (max-width: 640px) {
    .hero { padding-block: 12px 72px; }
  }
</style>
