---
// "How a client request moves through my lane": wide swimlane for tablets and desktop, vertical lanes for phones.
---

<figure class="diagram">
  <!-- Wide swimlane for tablets and desktop -->
  <div class="dg-wide diagram-scroll" tabindex="0" role="region" aria-label="Diagram: how a client request moves through my lane">
    <svg viewBox="0 0 1160 330" role="img" aria-labelledby="dg-t dg-d">
      <title id="dg-t">How a client request moves through my lane</title>
      <desc id="dg-d">BPMN diagram with three lanes. The client sends a request. I gather requirements and write the user story with acceptance criteria. Developers build and QC tests it. The client runs UAT: if it fails, it goes back to the user story; if it passes, it is signed off.</desc>
      <defs>
        <marker id="arw" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" class="arw" />
        </marker>
      </defs>
      <rect x="1" y="1" width="1158" height="328" rx="4" class="pool-r" />
      <rect x="41" y="110" width="1117" height="110" class="lane-me" />
      <path d="M1 110H1159M1 220H1159M41 1V329" class="sep" />
      <text transform="translate(26 55) rotate(-90)" class="lane-t">Client</text>
      <text transform="translate(26 165) rotate(-90)" class="lane-t me">Me</text>
      <text transform="translate(26 275) rotate(-90)" class="lane-t">Dev, QC</text>

      <g class="n" style="--d:0">
        <circle cx="100" cy="55" r="16" class="ev-s" />
        <text x="100" y="28" class="cap">Request</text>
      </g>
      <path d="M140 52H118" class="assoc n" style="--d:0.2" />
      <g class="n" style="--d:0.2" lang="id">
        <rect x="142" y="16" width="232" height="78" class="stk" transform="rotate(-2 258 55)" />
        <text x="156" y="44" class="hand" transform="rotate(-2 258 55)">&ldquo;Tiap pengajuan harus</text>
        <text x="156" y="66" class="hand" transform="rotate(-2 258 55)">di-approve dulu.&rdquo;</text>
        <text x="156" y="85" class="hand sm" transform="rotate(-2 258 55)" lang="en">Kickoff: every request needs approval</text>
      </g>

      <path d="M100 71V165H148" class="flow" marker-end="url(#arw)" style="--d:0.3" />
      <g class="n" style="--d:0.6">
        <rect x="150" y="130" width="130" height="70" rx="10" class="task-r" />
        <text x="215" y="161" class="lbl">Gather</text>
        <text x="215" y="181" class="lbl sm">+ scope</text>
      </g>
      <path d="M280 165H318" class="flow" marker-end="url(#arw)" style="--d:0.8" />
      <g class="n" style="--d:1">
        <rect x="320" y="130" width="150" height="70" rx="10" class="task-r me" />
        <text x="395" y="161" class="lbl">User story</text>
        <text x="395" y="181" class="lbl sm">+ acceptance criteria</text>
      </g>

      <path d="M470 165H575V238" class="flow" marker-end="url(#arw)" style="--d:1.2" />
      <g class="n" style="--d:1.4">
        <rect x="510" y="240" width="130" height="70" rx="10" class="task-r" />
        <text x="575" y="280" class="lbl">Build</text>
      </g>
      <path d="M640 275H678" class="flow" marker-end="url(#arw)" style="--d:1.6" />
      <g class="n" style="--d:1.8">
        <rect x="680" y="240" width="130" height="70" rx="10" class="task-r" />
        <text x="745" y="280" class="lbl">QC test</text>
      </g>

      <path d="M810 275H915V92" class="flow" marker-end="url(#arw)" style="--d:2" />
      <g class="n" style="--d:2.2">
        <rect x="850" y="20" width="130" height="70" rx="10" class="task-r" />
        <text x="915" y="60" class="lbl">UAT</text>
      </g>
      <path d="M980 55H1002" class="flow" marker-end="url(#arw)" style="--d:2.4" />
      <g class="n" style="--d:2.5">
        <path d="M1030 27L1058 55L1030 83L1002 55Z" class="gw" />
        <path d="M1021 46L1039 64M1039 46L1021 64" class="gw-x" />
      </g>
      <path d="M1058 55H1092" class="flow" marker-end="url(#arw)" style="--d:2.7" />
      <text x="1075" y="45" class="cap" style="--d:2.7">Yes</text>
      <path d="M1030 27V8H395V128" class="flow loop" marker-end="url(#arw)" style="--d:2.7" />
      <text x="1040" y="20" class="cap left" style="--d:2.7">No</text>
      <g class="n" style="--d:3">
        <circle cx="1110" cy="55" r="16" class="ev-e" />
        <text x="1110" y="94" class="cap strong">Signed off</text>
      </g>
    </svg>
  </div>

  <!-- Same flow with vertical lanes for phones -->
  <div class="dg-tall">
    <svg viewBox="0 0 360 640" role="img" aria-labelledby="dgm-t">
      <title id="dgm-t">How a client request moves through my lane: client request, gather and scope, user story, build, QC test, client UAT, then signed off or back to the user story.</title>
      <defs>
        <marker id="arw-m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" class="arw" />
        </marker>
      </defs>
      <rect x="1" y="1" width="358" height="638" rx="4" class="pool-r" />
      <rect x="120" y="33" width="120" height="605" class="lane-me" />
      <path d="M1 32H359M120 1V639M240 1V639" class="sep" />
      <text x="60" y="22" class="lane-t">Client</text>
      <text x="180" y="22" class="lane-t me">Me</text>
      <text x="300" y="22" class="lane-t">Dev, QC</text>

      <g class="n" style="--d:0">
        <circle cx="60" cy="70" r="14" class="ev-s" />
        <text x="60" y="102" class="cap">Request</text>
      </g>
      <path d="M74 70H180V106" class="flow" marker-end="url(#arw-m)" style="--d:0.2" />
      <g class="n" style="--d:0.4">
        <rect x="130" y="108" width="100" height="52" rx="8" class="task-r" />
        <text x="180" y="131" class="lbl">Gather</text>
        <text x="180" y="149" class="lbl sm">+ scope</text>
      </g>
      <path d="M180 160V188" class="flow" marker-end="url(#arw-m)" style="--d:0.6" />
      <g class="n" style="--d:0.8">
        <rect x="126" y="190" width="108" height="56" rx="8" class="task-r me" />
        <text x="180" y="214" class="lbl">User story</text>
        <text x="180" y="233" class="lbl sm">+ criteria</text>
      </g>
      <path d="M234 218H300V268" class="flow" marker-end="url(#arw-m)" style="--d:1" />
      <g class="n" style="--d:1.2">
        <rect x="250" y="270" width="100" height="48" rx="8" class="task-r" />
        <text x="300" y="299" class="lbl">Build</text>
      </g>
      <path d="M300 318V350" class="flow" marker-end="url(#arw-m)" style="--d:1.4" />
      <g class="n" style="--d:1.6">
        <rect x="250" y="352" width="100" height="48" rx="8" class="task-r" />
        <text x="300" y="381" class="lbl">QC test</text>
      </g>
      <path d="M250 376H60V428" class="flow" marker-end="url(#arw-m)" style="--d:1.8" />
      <g class="n" style="--d:2">
        <rect x="10" y="430" width="100" height="48" rx="8" class="task-r" />
        <text x="60" y="459" class="lbl">UAT</text>
      </g>
      <path d="M60 478V500" class="flow" marker-end="url(#arw-m)" style="--d:2.2" />
      <g class="n" style="--d:2.3">
        <path d="M60 502L82 524L60 546L38 524Z" class="gw" />
        <path d="M53 517L67 531M67 517L53 531" class="gw-x" />
      </g>
      <path d="M82 524H112V218H124" class="flow loop" marker-end="url(#arw-m)" style="--d:2.5" />
      <text x="88" y="516" class="cap left" style="--d:2.5">No</text>
      <path d="M60 546V574" class="flow" marker-end="url(#arw-m)" style="--d:2.5" />
      <text x="70" y="564" class="cap left" style="--d:2.5">Yes</text>
      <g class="n" style="--d:2.7">
        <circle cx="60" cy="590" r="14" class="ev-e" />
        <text x="60" y="626" class="cap strong">Signed off</text>
      </g>
    </svg>
  </div>
  <figcaption>One request, modeled the way I work: my lane sits between the client and the build.</figcaption>
</figure>

<style is:global>
  /* Draw the flow in order on first load */
  @media (prefers-reduced-motion: no-preference) {
    .diagram .flow { opacity: 0; stroke-dasharray: 1200; stroke-dashoffset: 1200; animation: trace 0.6s cubic-bezier(0.65, 0, 0.35, 1) forwards; animation-delay: calc(var(--d) * 1s); }
    .diagram .flow.loop { animation-duration: 1.1s; }
    .diagram .n, .diagram .cap { opacity: 0; animation: show 0.4s ease-out forwards; animation-delay: calc(var(--d) * 1s); }
    .diagram .n .cap { animation: none; opacity: 1; }
    @keyframes trace { 15% { opacity: 1; } to { stroke-dashoffset: 0; opacity: 1; } }
    @keyframes show { to { opacity: 1; } }
  }
  .dg-wide svg { min-width: 760px; }
  .dg-tall { display: none; }

  @media (max-width: 640px) {
    .dg-wide { display: none; }
    .dg-tall { display: block; }
  }
</style>
