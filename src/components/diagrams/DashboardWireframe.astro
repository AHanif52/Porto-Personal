---
// Monitoring dashboard wireframe, recreated from the clickable mockup.
---

<div class="diagram-scroll art-scroll" tabindex="0" role="region" aria-label="Wireframe: monitoring dashboard">
  <svg viewBox="0 0 760 440" role="img" aria-labelledby="wf-t">
    <title id="wf-t">Wireframe of the monitoring dashboard: filters on the left, six status bucket cards on the right, then a status table with export whose cells open the filtered list, and a bar chart by city. Tables and charts alternate down the page.</title>
    <rect x="1" y="1" width="758" height="438" rx="6" class="pool-r" />
    <path d="M1 40H759" class="sep thin" />
    <circle cx="20" cy="20" r="5" class="wf-dot" /><circle cx="36" cy="20" r="5" class="wf-dot" /><circle cx="52" cy="20" r="5" class="wf-dot" />
    <text x="380" y="25" class="lane-t">Dashboard: handover overview</text>

    <rect x="16" y="56" width="304" height="152" rx="6" class="wf-box" />
    <text x="30" y="76" class="wf-t">Filter</text>
    <rect x="30" y="88" width="80" height="8" rx="2" class="wf-ph" /><rect x="120" y="84" width="186" height="18" rx="4" class="wf-in" /><text x="296" y="97" class="wf-t">&#9662;</text>
    <rect x="30" y="116" width="64" height="8" rx="2" class="wf-ph" /><rect x="120" y="112" width="186" height="18" rx="4" class="wf-in" /><text x="296" y="125" class="wf-t">&#9662;</text>
    <rect x="30" y="144" width="72" height="8" rx="2" class="wf-ph" /><rect x="120" y="140" width="186" height="18" rx="4" class="wf-in" /><text x="296" y="153" class="wf-t">&#9662;</text>
    <rect x="166" y="172" width="62" height="24" rx="4" class="wf-in" /><text x="197" y="188" class="wf-t mid">Reset</text>
    <rect x="236" y="172" width="70" height="24" rx="4" class="wf-btn" /><text x="271" y="188" class="wf-t mid ink">Apply</text>
    <rect x="336" y="64" width="196" height="40" rx="6" class="wf-box" />
    <text x="348" y="81" class="wf-t">Waiting review</text>
    <text x="348" y="97" class="wf-n">N jobs</text>
    <rect x="542" y="64" width="196" height="40" rx="6" class="wf-box" />
    <text x="554" y="81" class="wf-t">In review</text>
    <text x="554" y="97" class="wf-n">N jobs</text>
    <rect x="336" y="112" width="196" height="40" rx="6" class="wf-box" />
    <text x="348" y="129" class="wf-t">Revise</text>
    <text x="348" y="145" class="wf-n">N jobs</text>
    <rect x="542" y="112" width="196" height="40" rx="6" class="wf-box" />
    <text x="554" y="129" class="wf-t">Approved</text>
    <text x="554" y="145" class="wf-n">N jobs</text>
    <rect x="336" y="160" width="196" height="40" rx="6" class="wf-box" />
    <text x="348" y="177" class="wf-t">Handover</text>
    <text x="348" y="193" class="wf-n">N jobs</text>
    <rect x="542" y="160" width="196" height="40" rx="6" class="wf-box" />
    <text x="554" y="177" class="wf-t">Done</text>
    <text x="554" y="193" class="wf-n">N jobs</text>

    <rect x="16" y="222" width="728" height="96" rx="6" class="wf-box" />
    <text x="30" y="242" class="wf-t">Submission by status</text>
    <rect x="672" y="229" width="60" height="20" rx="4" class="wf-in" /><text x="702" y="243" class="wf-t mid">Export</text>
    <path d="M30 256H730M30 276H730M30 296H730" class="wf-rule" />
    <rect x="40" y="262" width="110" height="8" rx="2" class="wf-ph" /><rect x="260" y="262" width="50" height="8" rx="2" class="wf-ph" /><rect x="420" y="262" width="50" height="8" rx="2" class="wf-ph" /><rect x="580" y="262" width="50" height="8" rx="2" class="wf-ph" />
    <rect x="40" y="282" width="90" height="8" rx="2" class="wf-ph" /><rect x="260" y="282" width="40" height="8" rx="2" class="wf-link" /><rect x="420" y="282" width="40" height="8" rx="2" class="wf-ph" /><rect x="580" y="282" width="40" height="8" rx="2" class="wf-ph" />
    <rect x="40" y="302" width="120" height="8" rx="2" class="wf-ph" /><rect x="260" y="302" width="46" height="8" rx="2" class="wf-ph" /><rect x="420" y="302" width="46" height="8" rx="2" class="wf-ph" /><rect x="580" y="302" width="46" height="8" rx="2" class="wf-ph" />

    <rect x="16" y="328" width="728" height="100" rx="6" class="wf-box" />
    <text x="30" y="346" class="wf-t">Chart by city</text>
    <rect x="40" y="358" width="60" height="7" rx="2" class="wf-ph" /><rect x="110" y="358" width="300" height="7" rx="2" class="wf-bar" />
    <rect x="40" y="371" width="60" height="7" rx="2" class="wf-ph" /><rect x="110" y="371" width="240" height="7" rx="2" class="wf-bar" />
    <rect x="40" y="384" width="60" height="7" rx="2" class="wf-ph" /><rect x="110" y="384" width="190" height="7" rx="2" class="wf-bar" />
    <rect x="40" y="397" width="60" height="7" rx="2" class="wf-ph" /><rect x="110" y="397" width="150" height="7" rx="2" class="wf-bar" />
    <rect x="40" y="410" width="60" height="7" rx="2" class="wf-ph" /><rect x="110" y="410" width="110" height="7" rx="2" class="wf-bar" />

    <path d="M300 286C380 286 440 320 470 350" class="assoc" />
    <g transform="rotate(-2 520 380)">
      <rect x="470" y="344" width="250" height="66" class="stk" />
      <text x="484" y="370" class="hand">Status cells open the</text>
      <text x="484" y="394" class="hand">filtered list. One click to act.</text>
    </g>
  </svg>
</div>

<style is:global>
  .wf-box { fill: var(--bp-deep); stroke: var(--line); stroke-width: 1.5; }
  .wf-in { fill: none; stroke: var(--muted); stroke-width: 1.2; }
  .wf-btn { fill: var(--line); }
  .wf-ph { fill: rgb(215 230 247 / 0.22); }
  .wf-bar { fill: rgb(215 230 247 / 0.55); }
  .wf-link { fill: var(--accent); }
  .wf-rule { stroke: var(--faint); stroke-width: 1; }
  .wf-dot { fill: none; stroke: var(--muted); stroke-width: 1.2; }
  .wf-t { fill: var(--line); font-size: 12px; font-weight: 600; }
  .wf-t.mid { text-anchor: middle; }
  .wf-t.ink { fill: var(--bp-deep); }
  .wf-n { fill: #fff; font-size: 14px; font-weight: 800; }
</style>
