---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/kalam/400.css';
import '../styles/global.css';
import { title, description, person } from '../data/content';

const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f3a63" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <!-- Link previews in LinkedIn, WhatsApp and email -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mohammad Aufa Hanif, Project Analyst, on a blueprint background with a BPMN flow" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230f3a63'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%23FFD84A' stroke-width='3'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <slot />
  </body>
</html>
