---
import { featured } from '../data/content';
---

<!-- The main project sits on a leaning tinted band, the one place the page changes plane before Contact -->
<section id="work" class="band" aria-labelledby="feat-h">
  <div class="wrap">
    <div class="grid">
      <div data-reveal>
        <p class="meta">{featured.meta}</p>
        <h2 id="feat-h">{featured.title}</h2>
        <p class="role slant">{featured.role}</p>
        <p class="lead">{featured.summary}</p>
      </div>
      <!-- Status screen: each figure is a leaning bar, stepped like a menu list -->
      <dl class="status slant" data-reveal="bars">
        {featured.stats.map((s, i) => (
          <div style={`--i:${i}`}>
            <dt>{s.label}</dt>
            <dd>{s.n}</dd>
          </div>
        ))}
      </dl>
    </div>
    <ul class="did">
      {featured.did.map((d, i) => (
        <li data-reveal style={`--i:${i}`}>
          <h3 class="slant">{d.head}</h3>
          <p>{d.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .band { background: var(--surface); padding-block: 210px 200px; clip-path: polygon(0 110px, 100% 0, 100% calc(100% - 110px), 0 100%); scroll-margin-top: 0; }
  .grid { display: grid; grid-template-columns: 6fr 5fr; gap: 72px; align-items: center; }
  h2 { max-width: 15ch; }
  .role { margin-top: 18px; font-size: 1.35rem; letter-spacing: 0.02em; }
  .lead { margin-top: 20px; }

  .status { display: grid; gap: 12px; padding-right: 28px; }
  .status div {
    display: flex; justify-content: space-between; align-items: baseline; gap: 24px;
    margin-left: calc(var(--i) * 26px); padding: 2px 34px 2px 28px;
    background: var(--bg); transform: skewX(var(--skew));
  }
  .status div:first-child { background: var(--ink); color: var(--bg); box-shadow: 10px 9px 0 var(--acc); margin-bottom: 8px; }
  dt { font-size: 1.5rem; letter-spacing: 0.01em; }
  dd { font-size: clamp(3.6rem, 6vw, 5.4rem); line-height: 1; }

  /* The bars slide in one after another, once, when the panel enters the viewport */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .status div { opacity: 0; transform: translateX(-80px) skewX(var(--skew)); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); transition-delay: calc(var(--i) * 110ms); }
    .status.is-in div { opacity: 1; transform: skewX(var(--skew)); }
  }

  .did { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 48px; margin-top: 88px; }
  .did h3 { font-size: 1.5rem; letter-spacing: 0.02em; padding-bottom: 12px; border-bottom: 2px solid var(--ink); }
  .did p { color: var(--mute); margin-top: 14px; }

  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; gap: 56px; align-items: start; }
    .did { grid-template-columns: 1fr; gap: 28px; margin-top: 64px; }
  }
  @media (max-width: 720px) {
    .band { padding-block: 120px 116px; clip-path: polygon(0 56px, 100% 0, 100% calc(100% - 56px), 0 100%); }
    .status { padding-inline: 12px 18px; }
    .status div { margin-left: calc(var(--i) * 10px); padding-inline: 20px 22px; }
    dt { font-size: 1.2rem; }
  }
</style>
