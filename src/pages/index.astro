<style is:global>
  /*
    Blueprint theme: one fixed theme on purpose (the blueprint IS the identity).
    Yellow means only three things: me, an outcome, or the main action.
  */
  :root {
    --bp: #0f3a63;
    --bp-deep: #0b2e50;
    --bp-lane: rgb(255 255 255 / 0.035);
    --line: #d7e6f7;
    --muted: #9fb8d4;
    --faint: rgb(215 230 247 / 0.28);
    --grid: rgb(215 230 247 / 0.07);
    --accent: #ffd84a;
    --accent-ink: #3a2e00;
    --radius: 10px;
    --sans: 'Schibsted Grotesk Variable', system-ui, sans-serif;
    --hand: 'Kalam', 'Comic Sans MS', cursive;
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    color: var(--line);
    font: 400 1.0625rem/1.6 var(--sans);
    -webkit-font-smoothing: antialiased;
    background-color: var(--bp);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px),
      linear-gradient(rgb(215 230 247 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(215 230 247 / 0.03) 1px, transparent 1px);
    background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
  }
  h1, h2, h3, p, ul, ol, dl, dd, figure { margin: 0; }
  ul, ol { padding: 0; list-style: none; }
  a { color: var(--line); text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  a:hover { color: var(--accent); }
  a:focus-visible, .diagram-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .wrap { width: min(1160px, 100% - 32px); margin-inline: auto; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 16px; background: var(--bp-deep); padding: 8px 12px; z-index: 10; }

  /* BPMN events: thin ring = start, thick ring = end */
  .ev { display: inline-block; width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--line); flex: none; }
  .ev-sm { width: 14px; height: 14px; }
  .ev-end { border-width: 4px; }
  .ev-big { width: 56px; height: 56px; border-width: 7px; border-color: var(--accent); }

  .top { display: flex; justify-content: space-between; align-items: center; min-height: 72px; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .top nav { display: flex; align-items: center; gap: 24px; }
  .top nav a { text-decoration: none; font-weight: 500; }
  .nav-cv { padding: 6px 12px; border: 1.5px solid var(--line); border-radius: var(--radius); white-space: nowrap; }
  .nav-cv:hover { border-color: var(--accent); }

  /* Hero */
  .hero { padding-block: 32px 112px; }
  .intro { display: grid; grid-template-columns: 1.25fr 1fr; gap: 56px; align-items: end; margin-bottom: 48px; }
  .who { display: flex; flex-direction: column; gap: 16px; }
  /* Portrait as the page's BPMN start event: thin ring, set apart from the photo */
  .avatar { width: 168px; height: 168px; border-radius: 50%; display: block; outline: 2px solid var(--line); outline-offset: 8px; margin-bottom: 32px; }
  h1 { font-size: clamp(2.6rem, 6.4vw, 5rem); line-height: 1; font-weight: 800; letter-spacing: -0.04em; max-width: 11ch; color: #fff; }
  .role { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; color: var(--accent); }
  .role span { display: block; font-size: 0.55em; font-weight: 500; letter-spacing: 0; color: var(--line); margin-top: 6px; }
  .proof { font-size: 1.15rem; max-width: 38ch; }
  .actions { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .btn {
    display: inline-block; padding: 12px 22px; border-radius: var(--radius); font-weight: 700; text-decoration: none;
    border: 1.5px solid var(--line); white-space: nowrap; transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn:hover { transform: translateY(-2px); color: var(--line); }
  .btn-solid { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .btn-solid:hover { color: var(--accent-ink); }
  .btn:active, .nav-cv:active { transform: scale(0.98); }
  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } .btn:hover { transform: none; } }

  /* Diagrams: real BPMN in SVG. Text stays text, so it is readable by people and parsers. */
  .diagram-scroll { overflow-x: auto; }
  .diagram svg, .artifact svg { display: block; width: 100%; height: auto; font-family: var(--sans); }
  .dg-wide svg { min-width: 760px; }
  .dg-tall { display: none; }
  .diagram figcaption, .artifact figcaption { margin-top: 12px; font-size: 0.9rem; color: var(--muted); }
  .pool-r { fill: rgb(11 46 80 / 0.55); stroke: var(--line); stroke-width: 2; }
  .lane-me { fill: rgb(255 216 74 / 0.06); }
  .sep { stroke: var(--line); stroke-width: 2; fill: none; }
  .sep.thin { stroke-width: 1.5; }
  .lane-t { fill: var(--muted); font-size: 13px; font-weight: 700; text-anchor: middle; }
  .lane-t.xs { font-size: 11px; }
  .lane-t.me { fill: var(--accent); }
  .task-r { fill: var(--bp-deep); stroke: var(--line); stroke-width: 2; }
  .task-r.me { stroke: var(--accent); stroke-width: 2.5; }
  .lbl { fill: #fff; font-size: 15px; font-weight: 700; text-anchor: middle; }
  .lbl.s13 { font-size: 13px; }
  .lbl.sm { fill: var(--muted); font-size: 12px; font-weight: 500; }
  .cap { fill: var(--muted); font-size: 13px; text-anchor: middle; }
  .cap.left { text-anchor: start; }
  .cap.end-l { text-anchor: end; }
  .cap.strong { fill: var(--accent); font-weight: 700; font-size: 14px; }
  .ev-s { fill: var(--bp-deep); stroke: var(--line); stroke-width: 2; }
  .ev-e { fill: var(--bp-deep); stroke: var(--accent); stroke-width: 5; }
  .gw { fill: var(--bp-deep); stroke: var(--line); stroke-width: 2; }
  .gw-x { stroke: var(--line); stroke-width: 3; stroke-linecap: round; }
  .flow { fill: none; stroke: var(--line); stroke-width: 2; }
  .flow.loop { stroke: var(--muted); }
  .arw { fill: var(--line); }
  .assoc { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 4 4; fill: none; }
  .wf-box { fill: var(--bp-deep); stroke: var(--line); stroke-width: 1.5; }
  .wf-in { fill: none; stroke: var(--muted); stroke-width: 1.2; }
  .wf-btn { fill: var(--line); }
  .wf-ph { fill: rgb(215 230 247 / 0.22); }
  .wf-bar { fill: rgb(215 230 247 / 0.55); }
  .wf-link { fill: var(--accent); }
  .wf-rule { stroke: var(--faint); stroke-width: 1; }
  .wf-dot { fill: none; stroke: var(--muted); stroke-width: 1.2; }
  .wf-t { fill: var(--line); font-size: 12px; font-weight: 600; }
  .wf-t.mid { text-anchor: middle; }
  .wf-t.ink { fill: var(--bp-deep); }
  .wf-n { fill: #fff; font-size: 14px; font-weight: 800; }
  .stk { fill: var(--accent); filter: drop-shadow(0 8px 10px rgb(0 0 0 / 0.35)); }
  .hand { font-family: var(--hand); font-size: 18px; fill: var(--accent-ink); }
  .hand.sm { font-size: 13px; opacity: 0.75; }

  @media (prefers-reduced-motion: no-preference) {
    .diagram .flow { opacity: 0; stroke-dasharray: 1200; stroke-dashoffset: 1200; animation: trace 0.6s cubic-bezier(0.65, 0, 0.35, 1) forwards; animation-delay: calc(var(--d) * 1s); }
    .diagram .flow.loop { animation-duration: 1.1s; }
    .diagram .n, .diagram .cap { opacity: 0; animation: show 0.4s ease-out forwards; animation-delay: calc(var(--d) * 1s); }
    .diagram .n .cap { animation: none; opacity: 1; }
    @keyframes trace { 15% { opacity: 1; } to { stroke-dashoffset: 0; opacity: 1; } }
    @keyframes show { to { opacity: 1; } }
  }

  /* Spine: the sequence flow that runs through the page, drawn as you scroll */
  .spine { position: relative; }
  .spine::before {
    content: ''; position: absolute; top: -40px; bottom: -60px; left: max(16px, calc(50% - 580px));
    border-left: 2px solid var(--faint); transform-origin: top;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .spine::before { animation: draw linear both; animation-timeline: view(); animation-range: entry 10% exit 40%; }
      @keyframes draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    }
  }
  .block { padding-left: 40px; }
  .block + .block { margin-top: 128px; }
  .node-h {
    position: relative; display: inline-block; font-size: clamp(1.7rem, 3.2vw, 2.4rem); font-weight: 800;
    letter-spacing: -0.02em; margin-bottom: 36px; color: #fff;
  }
  /* A waypoint on the spine, not an event */
  .node-h::before {
    content: ''; position: absolute; left: -45px; top: 50%; width: 10px; height: 10px; margin-top: -5px;
    border-radius: 50%; background: var(--line);
  }

  /* Featured project: the peak of the page */
  .feature { border: 2px solid var(--line); border-radius: 4px; background: rgb(11 46 80 / 0.55); padding: clamp(24px, 4vw, 48px); }
  .f-meta { color: var(--muted); }
  .f-meta b { color: var(--line); margin-right: 8px; }
  .feature h3 { font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1.12; font-weight: 800; letter-spacing: -0.02em; color: #fff; margin-top: 8px; max-width: 22ch; }
  .summary { margin-top: 12px; max-width: 64ch; }
  .figs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin: 36px 0; padding-block: 24px; border-block: 1.5px solid var(--faint); }
  .figs div { display: flex; flex-direction: column; gap: 6px; }
  .figs dd { order: -1; }
  .figs dd { font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--accent); }
  .figs dt { color: var(--muted); font-size: 0.95rem; }
  .artifact { margin-bottom: 28px; }
  .art-tabs { display: flex; gap: 4px; margin-bottom: 14px; }
  .art-tabs button {
    font: 600 0.95rem var(--sans); color: var(--muted); background: none; cursor: pointer;
    border: 1.5px solid var(--faint); border-radius: 8px; padding: 8px 14px;
  }
  .art-tabs button[aria-selected='true'] { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }
  .art-tabs button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .figs { margin: 28px 0; }
  .art-scroll svg { min-width: 640px; }
  .did { margin-top: 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 32px; color: var(--muted); max-width: 920px; }
  .did li { padding-left: 18px; position: relative; font-size: 0.975rem; }
  .did li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 8px; height: 2px; background: var(--line); }

  /* Pool and lanes for the other projects */
  .pool { border: 2px solid var(--line); border-radius: 4px; background: rgb(11 46 80 / 0.55); margin-top: 32px; }
  .lane { display: grid; grid-template-columns: 64px 1fr; }
  .lane + .lane { border-top: 2px solid var(--line); }
  .lane-label {
    border-left: 2px solid var(--line); writing-mode: vertical-rl; transform: rotate(180deg);
    display: flex; align-items: center; justify-content: center; gap: 12px; padding: 20px 0; font-weight: 700; color: #fff;
    background: var(--bp-lane);
  }
  .lane-year { font-weight: 400; color: var(--muted); }
  .lane-body { padding: clamp(24px, 3.5vw, 40px); min-width: 0; }
  .lane-body h3 { font-size: clamp(1.35rem, 2.2vw, 1.75rem); line-height: 1.2; font-weight: 800; letter-spacing: -0.015em; color: #fff; }

  /* Hanging indent: wrapped lines start 30px in, leaving room for their incoming arrow */
  .strip { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 34px; margin-top: 20px; padding-left: 30px; }
  .strip li:first-child { margin-left: -30px; }
  .strip li {
    position: relative; border: 1.5px solid var(--line); border-radius: 8px; padding: 6px 12px; font-size: 0.9rem; font-weight: 500;
    background: var(--bp-deep); white-space: nowrap;
  }
  /* Arrows point INTO each step, so a wrapped line still starts with its incoming arrow */
  .strip li + li::after {
    content: ''; position: absolute; left: -28px; top: 50%; width: 20px; border-top: 1.5px solid var(--line);
  }
  .strip li + li::before {
    content: ''; position: absolute; left: -10px; top: 50%; margin-top: -5px; border: 5px solid transparent; border-left: 7px solid var(--line); border-right: 0;
